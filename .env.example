# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Opcional - caso queira salvar diretamente na nuvem)
# Obtenha estas chaves no painel do Supabase em Project Settings > API
VITE_SUPABASE_URL="https://sua-url-de-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"
